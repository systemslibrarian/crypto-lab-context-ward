{
  "name": "crypto-lab-context-ward",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run check:vendor && npm run check:claims && vitest run",
    "check:vendor": "node tools/check-vendor.mjs",
    "fixtures": "tsx tools/gen-fixtures.ts",
    "verify:py": "python3 verification/verify.py fixtures",
    "test:a11y": "playwright test",
    "check:claims": "node tools/check-claims.mjs",
    "check:fixtures": "npm run fixtures && git diff --exit-code -- fixtures"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "js-yaml": "^5.3.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  }
}
